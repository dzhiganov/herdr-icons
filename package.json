{
  "name": "herdr-icons",
  "version": "0.1.0",
  "private": true,
  "description": "Herdr plugin: animated pixel status icons for agents in the sidebar",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "preview": "tsc -p tsconfig.json && node dist/cli/preview.js",
    "setup-sidebar": "tsc -p tsconfig.json && node dist/cli/setup.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
